<?xml version="1.0" encoding="UTF-8"?>
<!--
  ENCLU 홈페이지 IIS 설정 (D:\WWW_ROOT\ENCLU_EC_RENEWAL\enclu-homepage)

  - 정적 파일(index.html, assets/)은 IIS 가 그대로 서빙
  - /api/* 는 URL Rewrite + ARR 로 PM2 의 Node 서비스(localhost:3200)에 프록시
  - 사전 조건: URL Rewrite 모듈, Application Request Routing 설치 후
    서버 수준 ARR 설정에서 "Enable proxy" 체크 (docs/contact-api.md 참고)
-->
<configuration>
  <system.webServer>

    <!-- 기본 문서 -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- 정적 파일 MIME (IIS 기본값에 없는 것만 추가) -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <!-- /api/* → Node 문의 API 프록시 -->
    <rewrite>
      <rules>
        <rule name="ENCLU contact API proxy" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="http://localhost:3200/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- 보안 응답 헤더 (정적·API 공통) -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
      </customHeaders>
    </httpProtocol>

    <!-- 서버 정보 헤더 제거 -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

  </system.webServer>

  <!-- /api 경로에만 요청 본문 64KB 제한 (문의 폼 JSON 은 16KB 이내) -->
  <location path="api">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="65536" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
