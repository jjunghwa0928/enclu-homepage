# ENCLU 문의 API 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올리지 않는다.

# 서비스 포트 (IIS ARR 가 http://localhost:3200 으로 프록시)
PORT=3200
# production 이면 TURNSTILE_SECRET 이 비어 있을 때 기동을 거부한다(봇 검증 없이 운영되는 것을 막음).
# PM2(ecosystem.config.js)가 production 으로 고정하므로 로컬 개발에서만 development 로 바꾼다.
NODE_ENV=production

# ---- SMTP (메일 발송) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# 465 포트(SMTPS)면 true, 587(STARTTLS)이면 false
SMTP_SECURE=false
SMTP_USER=noreply@enclu.co.kr
SMTP_PASS=change-me

# 발신자 / 수신자
MAIL_FROM="ENCLU 홈페이지 <noreply@enclu.co.kr>"
MAIL_TO=info@enclu.co.kr

# 고객 접수 확인 메일 (담당자 알림 성공 후 문의자 이메일로 자동 발송). 기본 true, 끄려면 false.
# 확인 메일 실패는 로그만 남기고 접수 응답은 성공으로 유지한다. 안내 문구의 연락처에는 MAIL_TO 가 들어간다.
CUSTOMER_ACK_ENABLED=true

# ---- Cloudflare Turnstile ----
# production 에서는 필수. development/test 에서만 비워 둘 수 있으며 그때는 검증을 건너뛰고 경고만 남긴다.
TURNSTILE_SECRET=

# ---- CORS ----
# 다른 도메인에서 호출을 허용할 때만 콤마로 나열. 비우면 same-origin 만 허용.
# 예: ALLOWED_ORIGINS=https://www.enclu.co.kr,https://enclu.co.kr
ALLOWED_ORIGINS=
